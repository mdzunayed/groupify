{
  "openapi": "3.0.3",
  "info": {
    "title": "Groupify development HTTP API",
    "version": "0.2.0",
    "description": "Implemented health and development-only explicit account bootstrap, in review. Bootstrap requires trusted development identity and database mapping rules. No live authentication, production provider/deployment, profile/lifecycle implementation or phase acceptance is established."
  },
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Public liveness and dependency-readiness probes. No product data."
    },
    {
      "name": "Accounts",
      "description": "Development identity-derived account bootstrap; no profile/recovery grant."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "Health"
        ],
        "summary": "Check process liveness",
        "description": "Serves without requiring database or Redis connectivity. Does not establish a live user session or product readiness.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Healthy"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "summary": "Check dependency and migration readiness",
        "description": "Requires PostgreSQL with PostGIS and Redis to respond, and every local migration name to be recorded as applied. Does not verify migration contents or product behavior.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Healthy"
          },
          "503": {
            "$ref": "#/components/responses/ReadinessUnavailable"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/accounts/bootstrap": {
      "post": {
        "operationId": "bootstrapDevelopmentAccount",
        "tags": [
          "Accounts"
        ],
        "summary": "Explicitly create or resolve the caller\u2019s development account",
        "description": "Requires current verified development provider identity. No body or an empty application/json object; unknown fields/query inputs are rejected. Existing inactive mapping returns 403 without reactivation or replacement. Repeated/concurrent calls converge to one exact identity mapping. Production/disabled/unconfigured verification fails closed. No account ID, subject, phone, role or profile comes from the caller. Success follows SQL commit; uncertain failures are not automatically retried.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyBootstrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AccountBootstrapped"
          },
          "201": {
            "$ref": "#/components/responses/AccountBootstrapped"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "HttpError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "REQUEST_TIMEOUT",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNPROCESSABLE_ENTITY",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR",
              "BAD_GATEWAY",
              "SERVICE_UNAVAILABLE",
              "GATEWAY_TIMEOUT",
              "REQUEST_FAILED"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Safe public text; clients must branch on status and code rather than message wording."
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "ReadinessUnavailable": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HttpError"
          },
          {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer",
                "enum": [
                  503
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "SERVICE_UNAVAILABLE"
                ]
              }
            }
          }
        ]
      },
      "AccountBootstrap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmptyBootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "headers": {
      "RequestId": {
        "description": "Fresh server-generated UUID v4 for this attempt. Incoming X-Request-Id values are ignored; this is not an idempotency key.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      },
      "NoStore": {
        "description": "Error responses must not be cached.",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        }
      }
    },
    "responses": {
      "Healthy": {
        "description": "The process can serve requests (liveness), or every readiness condition passed.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Health"
            }
          }
        }
      },
      "ReadinessUnavailable": {
        "description": "PostgreSQL/PostGIS, Redis or applied migration-name checks did not pass. No connection details are exposed.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReadinessUnavailable"
            }
          }
        }
      },
      "HttpError": {
        "description": "Shared safe HTTP error envelope. Status is 4xx/5xx; the body statusCode and requestId match the HTTP status and X-Request-Id header. No raw exception or request content is returned.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HttpError"
            }
          }
        }
      },
      "AccountBootstrapped": {
        "description": "Committed identity-derived account ID. HTTP 201 newly created, 200 existing active mapping; no profile/role or ongoing-state assertion.",
        "headers": {
          "X-Request-Id": {
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          },
          "Cache-Control": {
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountBootstrap"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "DevelopmentBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Opt-in non-production Clerk development session verification plus current provider status. Requires documented trusted configuration; never cookie/URL credentials."
      }
    }
  }
}

{
  "openapi": "3.0.3",
  "info": {
    "title": "Groupify development HTTP API",
    "version": "0.5.0",
    "description": "Implemented health, protected development account/bootstrap, self-profile text and community-scoped ride create/start/end, plus default-off community creation preview. All in review. Community Leader/Co-leader start/end authority confirmed2026-11-14. Pictures, community/ride listing, invitations, join/leave, tracking, recovery/deletion, production identity and live native/device evidence remain unfinished; no phase acceptance."
  },
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Public liveness and dependency-readiness probes. No product data."
    },
    {
      "name": "Accounts",
      "description": "Development identity-derived account bootstrap; no profile/recovery grant."
    },
    {
      "name": "Profiles",
      "description": "Active-self-only development profile text. Required picture/media support remains unfinished; no other-user access or profile-complete assertion."
    },
    {
      "name": "Communities",
      "description": "Development creation only, using current active account; no listing, invitations, role mutations or ride grants."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "Health"
        ],
        "summary": "Check process liveness",
        "description": "Serves without requiring database or Redis connectivity. Does not establish a live user session or product readiness.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Healthy"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "summary": "Check dependency and migration readiness",
        "description": "Requires PostgreSQL with PostGIS and Redis to respond, and every local migration name to be recorded as applied. Does not verify migration contents or product behavior.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Healthy"
          },
          "503": {
            "$ref": "#/components/responses/ReadinessUnavailable"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/accounts/bootstrap": {
      "post": {
        "operationId": "bootstrapDevelopmentAccount",
        "tags": [
          "Accounts"
        ],
        "summary": "Explicitly create or resolve the caller\u2019s development account",
        "description": "Requires current verified development provider identity. No body or an empty application/json object; unknown fields/query inputs are rejected. Existing inactive mapping returns 403 without reactivation or replacement. Repeated/concurrent calls converge to one exact identity mapping. Production/disabled/unconfigured verification fails closed. No account ID, subject, phone, role or profile comes from the caller. Success follows SQL commit; uncertain failures are not automatically retried.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyBootstrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AccountBootstrapped"
          },
          "201": {
            "$ref": "#/components/responses/AccountBootstrapped"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/me/profile": {
      "get": {
        "operationId": "getSelfProfileText",
        "tags": [
          "Profiles"
        ],
        "summary": "GET the active caller\u2019s own profile text",
        "description": "Current development bearer/provider/account checks. Identity is derived server-side; unknown/immutable/photo fields and query inputs are rejected. No other-user access, picture waiver, recovery or production availability is granted. Normalization bounds are reversible development choices in review. Errors do not prove non-commit; no automatic retry/idempotency-key cache.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ProfileText"
          },
          "304": {
            "$ref": "#/components/responses/ProfileTextNotModified"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        },
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Optional HTTP conditional read. Current authentication, active account and owned profile are evaluated before a matching condition can produce bodyless 304. No-store still prohibits caching; the app sends no conditional reads.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "createSelfProfileText",
        "tags": [
          "Profiles"
        ],
        "summary": "POST the active caller\u2019s own profile text",
        "description": "Current development bearer/provider/account checks. Identity is derived server-side; unknown/immutable/photo fields and query inputs are rejected. No other-user access, picture waiver, recovery or production availability is granted. Normalization bounds are reversible development choices in review. Errors do not prove non-commit; no automatic retry/idempotency-key cache.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "responses": {
          "201": {
            "$ref": "#/components/responses/ProfileText"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "409": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileText"
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateSelfProfileText",
        "tags": [
          "Profiles"
        ],
        "summary": "PATCH the active caller\u2019s own profile text",
        "description": "Current development bearer/provider/account checks. Identity is derived server-side; unknown/immutable/photo fields and query inputs are rejected. No other-user access, picture waiver, recovery or production availability is granted. Normalization bounds are reversible development choices in review. Errors do not prove non-commit; no automatic retry/idempotency-key cache.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ProfileText"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "412": {
            "$ref": "#/components/responses/HttpError"
          },
          "428": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchProfileText"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exactly the strong ETag from the latest self profile. Missing =>428; stale =>412; wildcard/weak/list/overflow is invalid.",
            "schema": {
              "type": "string",
              "pattern": "^\"profile-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-[1-9][0-9]{0,18}\"$"
            }
          }
        ]
      }
    },
    "/v1/communities": {
      "post": {
        "operationId": "createDevelopmentCommunity",
        "tags": [
          "Communities"
        ],
        "summary": "Create a community and its creator\u2019s initial Leader membership",
        "description": "Default-off controlled preview only: exact GROUPIFY_DEV_COMMUNITY_CREATION_ENABLED=true plus development/test mode required; production stays unavailable. Creator eligibility remains unresolved; current active account creation is a preview assumption, not accepted production permission. Strict name-only JSON. Current verified development identity and active mapped account determine the creator; no implicit account bootstrap. Community and initial Leader commit atomically before 201. Role in response describes creation, not cached permission. Name bounds are reversible development choices in review. No listing/cross-user metadata, invitations, role assignments or ride grants. Separate POSTs create separate communities; after uncertain outcomes do not retry blindly. No idempotency/reconciliation policy or production availability is implied.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommunityCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CommunityCreated"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/communities/{communityId}/rides": {
      "post": {
        "operationId": "createDevelopmentRide",
        "tags": [
          "Rides"
        ],
        "summary": "Create a community ride",
        "description": "Current verified development session, active mapped account and current community Leader/Co-leader membership required. Disabled/misconfigured or production identity unavailable. No query/actor/role/participant selectors. No implicit bootstrap or active communication/location access. Strict immediate or canonical UTC-millisecond scheduled intent; future checked by database clock. Separate POSTs create separate drafts; uncertain outcomes must not be blindly retried. No idempotency/reconciliation contract yet.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "parameters": [
          {
            "name": "communityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RideCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/RideCreated"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/communities/{communityId}/rides/{rideId}/start": {
      "post": {
        "operationId": "startDevelopmentRide",
        "tags": [
          "Rides"
        ],
        "summary": "Start a community ride",
        "description": "Current verified development session, active mapped account and current community Leader/Co-leader membership required. Disabled/misconfigured or production identity unavailable. No query/actor/role/participant selectors. No implicit bootstrap or active communication/location access. Empty body or JSON object only. Explicit manual action, including scheduled rides before planned time. Freshly authorized start on active/end on completed preserves metadata; end on draft/start on completed conflicts. No auto-enrollment, tracking or role assignment.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "parameters": [
          {
            "name": "communityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "rideId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRideCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RideActive"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "409": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/communities/{communityId}/rides/{rideId}/end": {
      "post": {
        "operationId": "endDevelopmentRide",
        "tags": [
          "Rides"
        ],
        "summary": "End a community ride",
        "description": "Current verified development session, active mapped account and current community Leader/Co-leader membership required. Disabled/misconfigured or production identity unavailable. No query/actor/role/participant selectors. No implicit bootstrap or active communication/location access. Empty body or JSON object only. Explicit manual action, including scheduled rides before planned time. Freshly authorized start on active/end on completed preserves metadata; end on draft/start on completed conflicts. No auto-enrollment, tracking or role assignment.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "parameters": [
          {
            "name": "communityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "rideId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRideCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/RideCompleted"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "409": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "HttpError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "REQUEST_TIMEOUT",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNPROCESSABLE_ENTITY",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR",
              "BAD_GATEWAY",
              "SERVICE_UNAVAILABLE",
              "GATEWAY_TIMEOUT",
              "REQUEST_FAILED",
              "PRECONDITION_FAILED",
              "PRECONDITION_REQUIRED"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Safe public text; clients must branch on status and code rather than message wording."
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "ReadinessUnavailable": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HttpError"
          },
          {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer",
                "enum": [
                  503
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "SERVICE_UNAVAILABLE"
                ]
              }
            }
          }
        ]
      },
      "AccountBootstrap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmptyBootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "CreateProfileText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "riderType"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "description": "NFC/trim normalized, 1\u201380 Unicode code points; normalized controls and isolated surrogates rejected."
          },
          "riderType": {
            "type": "string",
            "enum": [
              "motorcycle",
              "bicycle"
            ]
          },
          "vehicleDescription": {
            "type": "string",
            "nullable": true,
            "description": "Optional normalized plain text up to 160 code points; null/trimmed empty clears it. Omission preserves on PATCH."
          }
        }
      },
      "PatchProfileText": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "displayName": {
            "type": "string",
            "description": "NFC/trim normalized, 1\u201380 Unicode code points; normalized controls and isolated surrogates rejected."
          },
          "riderType": {
            "type": "string",
            "enum": [
              "motorcycle",
              "bicycle"
            ]
          },
          "vehicleDescription": {
            "type": "string",
            "nullable": true,
            "description": "Optional normalized plain text up to 160 code points; null/trimmed empty clears it. Omission preserves on PATCH."
          }
        }
      },
      "ProfileText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId",
          "displayName",
          "riderType",
          "vehicleDescription",
          "version"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "riderType": {
            "type": "string",
            "enum": [
              "motorcycle",
              "bicycle"
            ]
          },
          "vehicleDescription": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Positive PostgreSQL bigint serialized as decimal text; use returned ETag without Number coercion."
          },
          "profileId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated profile identity; not accepted in writes and not an access token."
          }
        }
      },
      "CommunityCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "NFC/trim normalized, 1\u2013100 Unicode code points; controls/isolated surrogates rejected. Reversible development bound in review, not a member/population cap."
          }
        }
      },
      "CommunityCreated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "role": {
            "type": "string",
            "enum": [
              "Leader"
            ],
            "description": "Initial creator role at commit; future actions must independently authorize the current membership."
          }
        }
      },
      "RideCreate": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "immediate"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "scheduledFor"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "scheduled"
                ]
              },
              "scheduledFor": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
              }
            }
          }
        ]
      },
      "EmptyRideCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "RideCreated": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "communityId",
              "mode",
              "scheduledFor",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "communityId": {
                "type": "string",
                "format": "uuid"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "immediate"
                ]
              },
              "scheduledFor": {
                "type": "string",
                "nullable": true,
                "enum": [
                  null
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "communityId",
              "mode",

{
  "openapi": "3.0.3",
  "info": {
    "title": "Groupify development HTTP API",
    "version": "0.3.0",
    "description": "Implemented health, protected development account bootstrap and active-self profile text, in review. Pictures, app integration, recovery/deletion, production identity and live native/device evidence remain unfinished; no phase acceptance."
  },
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Public liveness and dependency-readiness probes. No product data."
    },
    {
      "name": "Accounts",
      "description": "Development identity-derived account bootstrap; no profile/recovery grant."
    },
    {
      "name": "Profiles",
      "description": "Active-self-only development profile text. Required picture/media support remains unfinished; no other-user access or profile-complete assertion."
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "Health"
        ],
        "summary": "Check process liveness",
        "description": "Serves without requiring database or Redis connectivity. Does not establish a live user session or product readiness.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Healthy"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "Health"
        ],
        "summary": "Check dependency and migration readiness",
        "description": "Requires PostgreSQL with PostGIS and Redis to respond, and every local migration name to be recorded as applied. Does not verify migration contents or product behavior.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Healthy"
          },
          "503": {
            "$ref": "#/components/responses/ReadinessUnavailable"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/accounts/bootstrap": {
      "post": {
        "operationId": "bootstrapDevelopmentAccount",
        "tags": [
          "Accounts"
        ],
        "summary": "Explicitly create or resolve the caller\u2019s development account",
        "description": "Requires current verified development provider identity. No body or an empty application/json object; unknown fields/query inputs are rejected. Existing inactive mapping returns 403 without reactivation or replacement. Repeated/concurrent calls converge to one exact identity mapping. Production/disabled/unconfigured verification fails closed. No account ID, subject, phone, role or profile comes from the caller. Success follows SQL commit; uncertain failures are not automatically retried.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyBootstrapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AccountBootstrapped"
          },
          "201": {
            "$ref": "#/components/responses/AccountBootstrapped"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      }
    },
    "/v1/me/profile": {
      "get": {
        "operationId": "getSelfProfileText",
        "tags": [
          "Profiles"
        ],
        "summary": "GET the active caller\u2019s own profile text",
        "description": "Current development bearer/provider/account checks. Identity is derived server-side; unknown/immutable/photo fields and query inputs are rejected. No other-user access, picture waiver, recovery or production availability is granted. Normalization bounds are reversible development choices in review. Errors do not prove non-commit; no automatic retry/idempotency-key cache.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ProfileText"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        }
      },
      "post": {
        "operationId": "createSelfProfileText",
        "tags": [
          "Profiles"
        ],
        "summary": "POST the active caller\u2019s own profile text",
        "description": "Current development bearer/provider/account checks. Identity is derived server-side; unknown/immutable/photo fields and query inputs are rejected. No other-user access, picture waiver, recovery or production availability is granted. Normalization bounds are reversible development choices in review. Errors do not prove non-commit; no automatic retry/idempotency-key cache.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "responses": {
          "201": {
            "$ref": "#/components/responses/ProfileText"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "409": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProfileText"
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateSelfProfileText",
        "tags": [
          "Profiles"
        ],
        "summary": "PATCH the active caller\u2019s own profile text",
        "description": "Current development bearer/provider/account checks. Identity is derived server-side; unknown/immutable/photo fields and query inputs are rejected. No other-user access, picture waiver, recovery or production availability is granted. Normalization bounds are reversible development choices in review. Errors do not prove non-commit; no automatic retry/idempotency-key cache.",
        "security": [
          {
            "DevelopmentBearer": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ProfileText"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "412": {
            "$ref": "#/components/responses/HttpError"
          },
          "428": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          },
          "415": {
            "$ref": "#/components/responses/HttpError"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchProfileText"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exactly the strong ETag from the latest self profile. Missing =>428; stale =>412; wildcard/weak/list/overflow is invalid.",
            "schema": {
              "type": "string",
              "pattern": "^\"profile-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-[1-9][0-9]{0,18}\"$"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "HttpError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statusCode",
          "code",
          "message",
          "requestId"
        ],
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "REQUEST_TIMEOUT",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "UNPROCESSABLE_ENTITY",
              "TOO_MANY_REQUESTS",
              "INTERNAL_ERROR",
              "BAD_GATEWAY",
              "SERVICE_UNAVAILABLE",
              "GATEWAY_TIMEOUT",
              "REQUEST_FAILED",
              "PRECONDITION_FAILED",
              "PRECONDITION_REQUIRED"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Safe public text; clients must branch on status and code rather than message wording."
          },
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "ReadinessUnavailable": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HttpError"
          },
          {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer",
                "enum": [
                  503
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "SERVICE_UNAVAILABLE"
                ]
              }
            }
          }
        ]
      },
      "AccountBootstrap": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EmptyBootstrapRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "CreateProfileText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName",
          "riderType"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "description": "NFC/trim normalized, 1\u201380 Unicode code points; normalized controls and isolated surrogates rejected."
          },
          "riderType": {
            "type": "string",
            "enum": [
              "motorcycle",
              "bicycle"
            ]
          },
          "vehicleDescription": {
            "type": "string",
            "nullable": true,
            "description": "Optional normalized plain text up to 160 code points; null/trimmed empty clears it. Omission preserves on PATCH."
          }
        }
      },
      "PatchProfileText": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "displayName": {
            "type": "string",
            "description": "NFC/trim normalized, 1\u201380 Unicode code points; normalized controls and isolated surrogates rejected."
          },
          "riderType": {
            "type": "string",
            "enum": [
              "motorcycle",
              "bicycle"
            ]
          },
          "vehicleDescription": {
            "type": "string",
            "nullable": true,
            "description": "Optional normalized plain text up to 160 code points; null/trimmed empty clears it. Omission preserves on PATCH."
          }
        }
      },
      "ProfileText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId",
          "displayName",
          "riderType",
          "vehicleDescription",
          "version"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "riderType": {
            "type": "string",
            "enum": [
              "motorcycle",
              "bicycle"
            ]
          },
          "vehicleDescription": {
            "type": "string",
            "nullable": true,
            "minLength": 1,
            "maxLength": 160
          },
          "version": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Positive PostgreSQL bigint serialized as decimal text; use returned ETag without Number coercion."
          },
          "profileId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated profile identity; not accepted in writes and not an access token."
          }
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Fresh server-generated UUID v4 for this attempt. Incoming X-Request-Id values are ignored; this is not an idempotency key.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RequestId"
        }
      },
      "NoStore": {
        "description": "Error responses must not be cached.",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        }
      }
    },
    "responses": {
      "Healthy": {
        "description": "The process can serve requests (liveness), or every readiness condition passed.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Health"
            }
          }
        }
      },
      "ReadinessUnavailable": {
        "description": "PostgreSQL/PostGIS, Redis or applied migration-name checks did not pass. No connection details are exposed.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReadinessUnavailable"
            }
          }
        }
      },
      "HttpError": {
        "description": "Shared safe HTTP error envelope. Status is 4xx/5xx; the body statusCode and requestId match the HTTP status and X-Request-Id header. No raw exception or request content is returned.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HttpError"
            }
          }
        }
      },
      "AccountBootstrapped": {
        "description": "Committed identity-derived account ID. HTTP 201 newly created, 200 existing active mapping; no profile/role or ongoing-state assertion.",
        "headers": {
          "X-Request-Id": {
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          },
          "Cache-Control": {
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountBootstrap"
            }
          }
        }
      },
      "ProfileText": {
        "description": "Caller-owned profile text snapshot; no picture or complete-profile claim. Strong ETag binds immutable profile identity and decimal version; use it unchanged.",
        "headers": {
          "X-Request-Id": {
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          },
          "Cache-Control": {
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "no-store"
              ]
            }
          },
          "ETag": {
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\"profile-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-[1-9][0-9]{0,18}\"$"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProfileText"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "DevelopmentBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Opt-in non-production Clerk development session verification plus current provider status. Requires documented trusted configuration; never cookie/URL credentials."
      }
    }
  }
}

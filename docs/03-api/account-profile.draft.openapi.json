      "patch": {
        "operationId": "draftUpdateOwnProfile",
        "tags": [
          "Proposed account/profile"
        ],
        "description": "PROPOSAL ONLY; not implemented. Active self only, strong If-Match. Omission preserves, explicit vehicle null clears. Unknown/immutable fields rejected.",
        "x-groupify-blocked-by": [
          "R1",
          "R4"
        ],
        "responses": {
          "200": {
            "description": "Updated own profile.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              },
              "ETag": {
                "description": "Strong profile version precondition token.",
                "required": true,
                "schema": {
                  "type": "string",
                  "pattern": "^\"profile-[1-9][0-9]*\"$"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/HttpError"
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "409": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {

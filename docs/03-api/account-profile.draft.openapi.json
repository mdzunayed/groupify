{
  "openapi": "3.0.3",
  "info": {
    "title": "Groupify account/profile/lifecycle \u2014 review draft",
    "version": "0.0.0-proposal",
    "description": "UNACCEPTED FULL CANDIDATE CONTRACT. Narrower development bootstrap and active-self text profile APIs now exist in openapi.json 0.3.0, with profile identity-bound ETags and 412/428 preconditions. This draft is not their actual response contract. Remaining R1\u2013R4/media/lifecycle/visibility choices and production identity/deployment remain unresolved; no phase acceptance."
  },
  "x-groupify-status": "proposal-not-implemented",
  "security": [
    {
      "ProposedBearer": []
    }
  ],
  "tags": [
    {
      "name": "Proposed account/profile",
      "description": "All paths are candidates for owner review, not discoverable product routes."
    }
  ],
  "paths": {
    "/v1/accounts/bootstrap": {
      "post": {
        "operationId": "draftBootstrapAccount",
        "tags": [
          "Proposed account/profile"
        ],
        "description": "PROPOSAL ONLY; not implemented. Create or resolve the exact verified provider/issuer/subject link. Never recover or replace a deactivated account implicitly.",
        "x-groupify-blocked-by": [
          "R1"
        ],
        "responses": {
          "200": {
            "description": "Existing active account.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveAccount"
                }
              }
            }
          },
          "201": {
            "description": "New account/link committed atomically.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/NoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveAccount"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/HttpError"
          },
          "401": {
            "$ref": "#/components/responses/HttpError"
          },
          "403": {
            "$ref": "#/components/responses/HttpError"
          },
          "409": {
            "$ref": "#/components/responses/HttpError"
          },
          "503": {
            "$ref": "#/components/responses/HttpError"
          },
          "default": {
            "$ref": "#/components/responses/HttpError"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "description": "Optional empty object only; identity is derived from verification, never caller fields."
              }
            }
          }
        }
      }
    },

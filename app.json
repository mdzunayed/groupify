{
  "expo": {
    "name": "Groupify",
    "slug": "groupify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/groupify-app-icon.png",
    "scheme": "groupify",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/brand/groupify-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/groupify-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/groupify-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/groupify-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1F5F9",
          "image": "./assets/brand/groupify-splash-mark.png",
          "imageWidth": 160
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

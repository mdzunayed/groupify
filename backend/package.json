{
  "name": "groupify-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "npm run build && node --test checks/health-unit.mjs checks/http-errors.mjs",
    "test:integration": "npm run build && node --test checks/health-integration.mjs",
    "test:integration:docker": "bash scripts/test-integration.sh",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "14.0.4"
    }
  }
}
